# Copy to .env or save your own keys from the local dashboard.
# Dashboard credentials persist in the local .env file. Never commit it.
OPENAI_API_KEY=
GEMINI_API_KEY=
TYPECAST_API_KEY=
META_ACCESS_TOKEN=
OPENAI_TEXT_MODEL=gpt-5-mini
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_QUALITY=medium
TEXT_PROVIDER=auto
CODEX_BIN=
CODEX_MODEL=
TYPECAST_VOICE_ID=
TYPECAST_TEMPO=1
META_API_VERSION=v26.0
PORT=4317
DATA_DIR=data
NODE_ENV=development
# Optional absolute path to ffprobe if it is not on PATH.
FFPROBE_PATH=

# Optional Claude Code CLI overrides. Subscription login is managed by Claude Code.
CLAUDE_CODE_BIN=
CLAUDE_CODE_MODEL=
